# ---------------------------------------------------------------------------
# GyanSetu backend environment
# Copy this file to server/.env and adjust for your machine.
# Never commit server/.env — it is ignored by Git.
# ---------------------------------------------------------------------------

# Runtime
NODE_ENV=development
PORT=5000
HOST=127.0.0.1

# MongoDB connection string
# Local: mongodb://127.0.0.1:27017/gyansetu
# Atlas: mongodb+srv://USER:PASSWORD@cluster.mongodb.net/gyansetu?retryWrites=true&w=majority
MONGO_URI=mongodb://127.0.0.1:27017/gyansetu

# Authentication
JWT_SECRET=replace-with-a-long-random-secret
JWT_ACCESS_TTL=2h
JWT_REFRESH_TTL_DAYS=7
DEFAULT_DEMO_PASSWORD=demo1234

# Python AI microservice (optional; backend falls back locally)
AI_SERVICE_URL=http://127.0.0.1:8000
AI_SERVICE_TOKEN=
AI_TIMEOUT_MS=8000
AI_RATE_LIMIT_MAX=30

# Frontend origin allowed by CORS (comma-separated for multiple origins)
CORS_ORIGIN=http://127.0.0.1:5173

# General API rate limiter
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300

# Optional behavior
LOG_REQUESTS=true
SEED_ON_START=false

# Set automatically by Vercel when running as a serverless function.
# Do not set this locally.
# VERCEL=1
